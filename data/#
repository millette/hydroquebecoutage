<script>
	const notifications = {
		debut: "2023-06-08 09:00",
		fin: "2026-12-31 23:59",
		type: "info",
		titre_fr: "",
		titre_en: "",
		message_debut_fr: "",
		message_debut_en: "The <i>Charter of the French language</i> and its regulations govern the",
		cta_fr: "",
		cta_en: "consultation of English&#8209;language content",
		message_fin_fr: "",
		message_fin_en: ".",
		url_fr: "",
		url_en: "https://www.quebec.ca/en/gouvernement/politiques-orientations/langue-francaise/modernization-charter-french-language",
		active_page: ["/poweroutages/"],
		have_icon: false
	}


	document.addEventListener("DOMContentLoaded", function () {
		afficherBanniere(notifications)
	});

	function afficherBanniere(notification) {
		const pageActifs = notification.active_page;
		const hrefUtilisateur = window.location.href;
		let isActive = false;
		const siToutesLesPagesSontActives = pageActifs[0] == '*';


		// Trouver si le url de la page est dans la liste des page active
		pageActifs.forEach(element => {
			if (hrefUtilisateur.includes(element.trim())) {
				isActive = true;
			}
		});

		// Si URL utilisateur est dans la liste des pages active OU si toutes les pages sont actives
		if (isActive || siToutesLesPagesSontActives) {

			const bodyWrapperEl = document.getElementById('hq-outer-wrapper');
			const pageLang = document.documentElement.lang;

			if (`${notification[`url_${pageLang}`]}` != null) {

			}

			// Créer le contenu de la div
			const notificationLink = `${notification[`url_${pageLang}`]}`;
			const notificationsHtml = document.createElement('div');
			notificationsHtml.classList.add('wrapper');

			const notificationText = document.createElement('p');
			notificationText.classList.add('hq-banner-notification-text');

			const notificationTitle = document.createElement('span');
			notificationTitle.classList.add('hq-banner-notification-titre');

			notificationsHtml.append(notificationText);
			notificationText.append(notificationTitle);

			notificationTitle.innerHTML = `${notification[`titre_${pageLang}`]}`;
			notificationText.innerHTML = `${notification[`message_debut_${pageLang}`]} `;

			// Ajouter le lien si un est disponible:
			if (notificationLink != null && notificationLink.length != 0) {

				// Vérifier si le lien est un lien externe:
				const notificationLinkOrigin = new URL(notificationLink);
				const isExternalURL = notificationLinkOrigin.origin !== location.origin;

				// Créer le lien selon ce qui est disponible dans le json.
				let notificationCta = `${notification[`cta_${pageLang}`]}`;

				const notificationUrl = document.createElement('a');
				notificationUrl.classList.add('hq-banner-notification-cta');
				notificationUrl.setAttribute(`href`, `${notification[`url_${pageLang}`]}`);
				notificationUrl.setAttribute(`target`, `_blank`);

				// Ajouter icone si lien externe:
				if (isExternalURL) {

					// Créer un non-breaking space entre le dernier mot et l'icone
					const words = notificationCta.split(' ');
					const lastWord = words.pop();
					const sentenceWithoutLastWord = words.join(' ');

					const externalSvg = pageLang === 'fr' ? "<svg class='hq-icone-petite' aria-label='Ce lien mène à l&#39;extérieur du site d&#39;Hydro-Québec.'><use href='/@hydroquebec/assets/dist/icones/sprite.svg#hq-icone-lien-externe' /></svg>" : "<svg class='hq-icone-petite' aria-label='This link will redirect you to an external site.'><use href='/@hydroquebec/assets/dist/icones/sprite.svg#hq-icone-lien-externe' /></svg>";

					notificationUrl.innerHTML = `${sentenceWithoutLastWord} <span class="hq-banner-notification-last-word"> ${lastWord} ${externalSvg}</span>`

				} else {
					notificationUrl.innerHTML = notificationCta;
				}

				notificationText.append(notificationUrl);
			}

			notificationText.innerHTML += `${notification[`message_fin_${pageLang}`]}`;

			const bannerNotificationEl = document.createElement('div');
			bannerNotificationEl.classList.add('hq-banner-notification', `${notification.type}`);
			bannerNotificationEl.setAttribute('aria-label', 'avertissement');
			bannerNotificationEl.setAttribute('role', 'region');
			bannerNotificationEl.append(notificationsHtml);

			bodyWrapperEl.insertBefore(bannerNotificationEl, bodyWrapperEl.children[0]);

			if (notification.have_icon) {
				const wrappelEl = document.querySelector('.hq-banner-notification .wrapper');
				wrappelEl.classList.add('has-icon');
			};
		}

	}

</script>
